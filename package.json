{
  "name": "@polaris/engine",
  "version": "0.4.1",
  "private": false,
  "type": "module",
  "description": "Modular browser-runtime framework for Polaris",
  "exports": {
    ".": "./src/index.js",
    "./navigation": "./src/navigation/controller.js",
    "./tabs": "./src/tabs/tab-manager.js",
    "./storage": "./src/storage/stores.js",
    "./cache": "./src/storage/cache-store.js",
    "./diagnostics": "./src/diagnostics/index.js",
    "./runtime": "./src/runtime/runtime-manager.js",
    "./security": "./src/security/permissions.js",
    "./settings": "./src/settings/settings-manager.js",
    "./extensions": "./src/extensions/extension-registry.js",
    "./commands": "./src/commands/command-registry.js",
    "./telemetry": "./src/telemetry/performance-monitor.js",
    "./adapters": "./src/adapters/view-adapter.js",
    "./platform": "./src/platform/web-platform.js",
    "./workers": "./src/platform/worker-manager.js",
    "./rpc": "./src/platform/message-rpc.js",
    "./dom": "./src/dom/dom-observer.js",
    "./mime": "./src/utils/mime.js",
    "./frames": "./src/adapters/frame-controller.js",
    "./plugins": "./src/extensions/plugin-manager.js",
    "./url-watcher": "./src/navigation/url-watcher.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/adapters/view-adapter.js"
  },
  "engines": { "node": ">=20" }
}
